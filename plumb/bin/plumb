#!/usr/bin/env bash
set -Eeuo pipefail

EDITOR_CMD="${PLUMB_EDITOR:-nvim}"
SEARCH_URL="${PLUMB_SEARCH_URL:-https://duckduckgo.com/?q=}"
PANEL_ID="${PLUMB_PANEL_ID:-davamos/plumb:actions}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/plumb"
LOG_FILE="$STATE_DIR/plumb.log"

mkdir -p "$STATE_DIR"

log() {
    printf '[%(%Y-%m-%d %H:%M:%S)T] %s\n' -1 "$*" >>"$LOG_FILE"
}

notify() {
    if command -v notify-send >/dev/null 2>&1; then
        notify-send --app-name="plumb" "$1" "${2:-}" >/dev/null 2>&1 || true
    fi
}

fail() {
    log "ERROR: $*"
    notify "Plumb failed" "$*"
    exit 1
}

launch() {
    log "launch: $(printf '%q ' "$@")"

    if [[ "${PLUMB_DRY_RUN:-0}" == 1 ]]; then
        printf 'launch:'
        printf ' %q' "$@"
        printf '\n'
        return 0
    fi

    if command -v setsid >/dev/null 2>&1; then
        setsid -f "$@" >>"$LOG_FILE" 2>&1 || fail "Could not launch: $1"
    else
        nohup "$@" >>"$LOG_FILE" 2>&1 </dev/null &
    fi
}

open_uri() {
    local uri="$1"

    if [[ -n "${PLUMB_OPENER:-}" ]]; then
        local -a opener
        read -r -a opener <<<"$PLUMB_OPENER"
        launch "${opener[@]}" "$uri"
    elif command -v xdg-open >/dev/null 2>&1; then
        launch xdg-open "$uri"
    elif command -v gio >/dev/null 2>&1; then
        launch gio open "$uri"
    else
        fail "Install xdg-utils or set PLUMB_OPENER."
    fi
}

run_in_terminal() {
    local -a cmd=("$@")

    if [[ -n "${PLUMB_TERMINAL:-}" ]]; then
        local -a terminal
        read -r -a terminal <<<"$PLUMB_TERMINAL"
        launch "${terminal[@]}" "${cmd[@]}"
        return
    fi

    if command -v foot >/dev/null 2>&1; then
        launch foot -e "${cmd[@]}"
    elif command -v kitty >/dev/null 2>&1; then
        launch kitty "${cmd[@]}"
    elif command -v ghostty >/dev/null 2>&1; then
        launch ghostty -e "${cmd[@]}"
    elif command -v alacritty >/dev/null 2>&1; then
        launch alacritty -e "${cmd[@]}"
    elif command -v wezterm >/dev/null 2>&1; then
        launch wezterm start -- "${cmd[@]}"
    elif command -v xterm >/dev/null 2>&1; then
        launch xterm -e "${cmd[@]}"
    else
        fail "No terminal found. Set PLUMB_TERMINAL, e.g. 'foot -e'."
    fi
}

open_editor() {
    local path="$1"
    local line="${2:-1}"
    local column="${3:-1}"

    case "${EDITOR_CMD##*/}" in
        code|codium)
            launch "$EDITOR_CMD" --goto "$path:$line:$column"
            ;;
        nvim|vim|vi)
            run_in_terminal "$EDITOR_CMD" "+call cursor($line,$column)" -- "$path"
            ;;
        hx|helix)
            run_in_terminal "$EDITOR_CMD" "$path:$line:$column"
            ;;
        *)
            run_in_terminal "$EDITOR_CMD" "+$line" "$path"
            ;;
    esac
}

# Keep this deliberately simple: it is the input behavior that worked with
# Mod+MouseLeft/Right in Niri.
read_selection() {
    if (( $# > 0 )); then
        printf '%s' "$*"
        return 0
    fi

    if [[ -p /dev/stdin ]]; then
        local piped
        piped="$(cat)"
        if [[ -n "$piped" ]]; then
            printf '%s' "$piped"
            return 0
        fi
    fi

    if command -v wl-paste >/dev/null 2>&1; then
        local selected=""
        selected="$(wl-paste --primary --no-newline 2>/dev/null || true)"
        if [[ -z "$selected" ]]; then
            selected="$(wl-paste --no-newline 2>/dev/null || true)"
        fi
        printf '%s' "$selected"
        return 0
    fi

    fail "wl-paste is missing. Install wl-clipboard."
}

resolve_path() {
    local path="$1"

    if [[ "$path" == "~/"* ]]; then
        path="$HOME/${path:2}"
    fi

    if [[ -e "$path" ]]; then
        realpath -m -- "$path"
        return 0
    fi

    if [[ -n "${PLUMB_ROOT:-}" && -e "$PLUMB_ROOT/$path" ]]; then
        realpath -m -- "$PLUMB_ROOT/$path"
        return 0
    fi

    return 1
}

open_path() {
    local path="$1"
    local line="${2:-1}"
    local column="${3:-1}"

    if [[ -d "$path" ]]; then
        open_uri "$path"
        return
    fi

    local mime
    mime="$(file --brief --mime-type -- "$path" 2>/dev/null || true)"

    case "$mime" in
        text/*|application/json|application/javascript|application/xml|application/x-shellscript|inode/x-empty)
            open_editor "$path" "$line" "$column"
            ;;
        *)
            open_uri "$path"
            ;;
    esac
}

urlencode() {
    command -v python3 >/dev/null 2>&1 || fail "python3 is required for web searches."
    python3 - "$1" <<'PY'
import sys
from urllib.parse import quote_plus
print(quote_plus(sys.argv[1]), end="")
PY
}


open_text_menu() {
    local text="$1"

    if ! command -v noctalia >/dev/null 2>&1; then
        log "noctalia command missing; falling back to web search"
        open_uri "${SEARCH_URL}$(urlencode "$text")"
        return
    fi

    local runtime_base="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}"
    local runtime_dir="$runtime_base/plumb"
    local selection_file="$runtime_dir/selection-$(date +%s%N)-$$.txt"

    umask 077
    mkdir -p -- "$runtime_dir" || fail "Could not create $runtime_dir"
    printf '%s' "$text" >"$selection_file" || fail "Could not store the selected text."

    log "panel-open: $PANEL_ID context=$selection_file"
    if noctalia msg panel-open "$PANEL_ID" "$selection_file" >>"$LOG_FILE" 2>&1; then
        return
    fi

    rm -f -- "$selection_file"
    notify "Plumb panel unavailable" "Falling back to DuckDuckGo."
    log "panel-open failed; falling back to web search"
    open_uri "${SEARCH_URL}$(urlencode "$text")"
}

main() {
    local text
    text="$(read_selection "$@")"
    text="$(printf '%s' "$text" | sed -e '1s/^[[:space:]]*//' -e '$s/[[:space:]]*$//')"

    log "input: $(printf '%q' "$text")"

    if [[ -z "$text" ]]; then
        notify "Nothing to plumb" "Select text first, or copy it with Ctrl+C."
        log "nothing selected"
        exit 1
    fi

    # Unwrap Markdown links: [label](target)
    local markdown_re='^\[[^]]+\]\((.+)\)$'
    if [[ "$text" =~ $markdown_re ]]; then
        text="${BASH_REMATCH[1]}"
    fi

    # Full URI schemes.
    case "$text" in
        http://*|https://*|ftp://*|file://*|mailto:*|tel:*|sms:*|magnet:*|tg://*|matrix:*|geo:*|gemini://*|ipfs://*)
            open_uri "$text"
            exit 0
            ;;
    esac

    # Email: address or Name <address>.
    local named_email_re='^.*<([[:alnum:]._%+-]+@[[:alnum:].-]+\.[[:alpha:]]{2,})>$'
    local email_re='^[[:alnum:]._%+-]+@[[:alnum:].-]+\.[[:alpha:]]{2,}$'
    if [[ "$text" =~ $named_email_re ]]; then
        open_uri "mailto:${BASH_REMATCH[1]}"
        exit 0
    fi
    if [[ "$text" =~ $email_re ]]; then
        open_uri "mailto:$text"
        exit 0
    fi

    # Manual pages.
    if [[ "$text" =~ ^([[:alnum:]_.+-]+)\(([[:alnum:]]+)\)$ ]]; then
        run_in_terminal man "${BASH_REMATCH[2]}" "${BASH_REMATCH[1]}"
        exit 0
    fi
    if [[ "$text" =~ ^man[[:space:]]+([[:alnum:]]+)[[:space:]]+([[:alnum:]_.+-]+)$ ]]; then
        run_in_terminal man "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
        exit 0
    fi
    if [[ "$text" =~ ^man[[:space:]]+([[:alnum:]_.+-]+)$ ]]; then
        run_in_terminal man "${BASH_REMATCH[1]}"
        exit 0
    fi

    # Explicit SSH commands only.
    if [[ "$text" =~ ^ssh[[:space:]]+-p[[:space:]]+([0-9]+)[[:space:]]+([^[:space:]]+)$ ]]; then
        run_in_terminal ssh -p "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
        exit 0
    fi
    if [[ "$text" =~ ^ssh[[:space:]]+([^[:space:]]+)$ ]]; then
        run_in_terminal ssh "${BASH_REMATCH[1]}"
        exit 0
    fi

    # Existing file with :line:column or :line.
    if [[ "$text" =~ ^(.+):([0-9]+):([0-9]+)$ ]]; then
        local path line column
        path="${BASH_REMATCH[1]}"
        line="${BASH_REMATCH[2]}"
        column="${BASH_REMATCH[3]}"
        if path="$(resolve_path "$path")"; then
            open_path "$path" "$line" "$column"
            exit 0
        fi
    fi
    if [[ "$text" =~ ^(.+):([0-9]+)$ ]]; then
        local path line
        path="${BASH_REMATCH[1]}"
        line="${BASH_REMATCH[2]}"
        if path="$(resolve_path "$path")"; then
            open_path "$path" "$line" 1
            exit 0
        fi
    fi

    local path
    if path="$(resolve_path "$text")"; then
        open_path "$path"
        exit 0
    fi

    # Git hosting shorthand.
    if [[ "$text" =~ ^gh:([^/[:space:]]+)/([^#[:space:]]+)(#([0-9]+))?$ ]]; then
        local uri="https://github.com/${BASH_REMATCH[1]}/${BASH_REMATCH[2]}"
        [[ -n "${BASH_REMATCH[4]:-}" ]] && uri+="/issues/${BASH_REMATCH[4]}"
        open_uri "$uri"
        exit 0
    fi
    if [[ "$text" =~ ^gl:([^/[:space:]]+)/([^#[:space:]]+)(#([0-9]+))?$ ]]; then
        local uri="https://gitlab.com/${BASH_REMATCH[1]}/${BASH_REMATCH[2]}"
        [[ -n "${BASH_REMATCH[4]:-}" ]] && uri+="/-/issues/${BASH_REMATCH[4]}"
        open_uri "$uri"
        exit 0
    fi

    # localhost and numeric IP addresses.
    if [[ "$text" =~ ^localhost(:[0-9]+)?(/.*)?$ ]]; then
        open_uri "http://$text"
        exit 0
    fi
    if [[ "$text" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}(:[0-9]+)?(/.*)?$ ]]; then
        open_uri "http://$text"
        exit 0
    fi

    # Phone numbers.
    if [[ "$text" =~ ^\+?[0-9][0-9[:space:]().-]{6,}[0-9]$ ]]; then
        local phone
        phone="$(printf '%s' "$text" | tr -cd '+0-9')"
        open_uri "tel:$phone"
        exit 0
    fi

    # Bare website names.
    if [[ "$text" =~ ^[[:alnum:]][[:alnum:].-]+\.[[:alpha:]]{2,}(/.*)?$ ]]; then
        open_uri "https://$text"
        exit 0
    fi

    # Structured selections above keep their direct actions. Ordinary prose
    # opens the native Noctalia action palette instead of searching immediately.
    open_text_menu "$text"
}

main "$@"
